# OpenAI Configuration (Required)
OPENAI_API_KEY=your_openai_api_key_here

# Vector Database Configuration
USE_VECTOR_DB=true
VECTOR_DB_TYPE=qdrant        # Options: memory, chroma, qdrant

# Qdrant Configuration (when VECTOR_DB_TYPE=qdrant)
QDRANT_URL=http://localhost:6333        # Local Qdrant instance
QDRANT_API_KEY=                         # Optional for local, required for Qdrant Cloud
QDRANT_COLLECTION=ayurveda-knowledge

# Alternative: Qdrant Cloud Configuration
# QDRANT_URL=https://your-cluster-url.qdrant.io
# QDRANT_API_KEY=qdr_your_api_key_here

# Legacy ChromaDB Configuration (when VECTOR_DB_TYPE=chroma)
# CHROMA_URL=http://localhost:8000
# CHROMA_COLLECTION_NAME=ayurveda-embeddings
# USE_CHROMA=true

# Development Settings
NODE_ENV=development
DEBUG=qdrant*,openai*                   # Enable debug logging
LANGCHAIN_VERBOSE=true
LANGCHAIN_TRACING_V2=false

# Optional Feature Flags
ENABLE_SEMANTIC_SEARCH=true
ENABLE_METADATA_FILTERING=true
ENABLE_HYBRID_SEARCH=false