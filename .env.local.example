# OpenAI Configuration (Required for all RAG implementations)
OPENAI_API_KEY=your_openai_api_key_here

# ============================================================================
# PINECONE HYBRID RAG CONFIGURATION (for /api/pineconehybridrag)
# ============================================================================

# Pinecone Cloud Vector Database (Required for hybrid RAG)
PINECONE_API_KEY=pcsk_your_pinecone_api_key_here
PINECONE_INDEX_NAME=ayurveda-knowledge
PINECONE_ENVIRONMENT=us-east-1-aws

# Hybrid Scoring Configuration
HYBRID_ALPHA=0.7                      # Weight: 0.7 = 70% vector + 30% keyword (BM25)
                                      # Range: 0.0 (pure keyword) to 1.0 (pure vector)
                                      # Recommended values:
                                      #   - 0.7-0.8: Balanced (default, best for most queries)
                                      #   - 0.5-0.6: More keyword weight (precise terminology)
                                      #   - 0.9-1.0: Pure semantic (conceptual queries)

USE_HYBRID_SCORING=true               # Enable hybrid scoring (default: true)
ENABLE_QUERY_EXPANSION=true           # Enable query expansion (default: true)

# ============================================================================
# LEGACY VECTOR DATABASE CONFIGURATION
# ============================================================================

# Vector Database Configuration (for /api/embedyurveda, /api/embedpinecone)
USE_VECTOR_DB=true
VECTOR_DB_TYPE=qdrant        # Options: memory, chroma, qdrant

# Qdrant Configuration (when VECTOR_DB_TYPE=qdrant)
QDRANT_URL=http://localhost:6333        # Local Qdrant instance
QDRANT_API_KEY=                         # Optional for local, required for Qdrant Cloud
QDRANT_COLLECTION=ayurveda-knowledge

# Alternative: Qdrant Cloud Configuration
# QDRANT_URL=https://your-cluster-url.qdrant.io
# QDRANT_API_KEY=qdr_your_api_key_here

# Legacy ChromaDB Configuration (when VECTOR_DB_TYPE=chroma)
# CHROMA_URL=http://localhost:8000
# CHROMA_COLLECTION_NAME=ayurveda-embeddings
# USE_CHROMA=true

# Development Settings
NODE_ENV=development
DEBUG=qdrant*,openai*                   # Enable debug logging
LANGCHAIN_VERBOSE=true
LANGCHAIN_TRACING_V2=false

# Optional Feature Flags
ENABLE_SEMANTIC_SEARCH=true
ENABLE_METADATA_FILTERING=true
ENABLE_HYBRID_SEARCH=false